# ============================================================================
# Pin manifest for the DarkMatter x86_64 / NetHunter Pro / KernelSU-Next build
# ----------------------------------------------------------------------------
# Sourced by .github/workflows/build-darkmatter-x86_64-nhpro.yml and by
# build-nh-pro.sh. Every component is pinned here; nothing floats on a branch.
#
# Format: KEY=VALUE, shell-sourceable, no spaces around '='.
# ============================================================================

# --- profile -----------------------------------------------------------------
PROFILE_ID=darkmatter-vivobook

# --- kernel ------------------------------------------------------------------
KERNEL_REPO=https://github.com/015stray91/kernel-zenith.git
KERNEL_BRANCH=6.12_KSU
KERNEL_PIN=7042991a5c9ddae256f3864a598017310bb5ff2c

# --- KernelSU-Next -----------------------------------------------------------
KSU_REPO=https://github.com/KernelSU-Next/KernelSU-Next.git
KSU_PIN=4c706b5938665866ebe16944a481a7b91e3396af

# --- NetHunter Pro amd64 payload --------------------------------------------
NH_REF=6.12_android-x86
NH_DIR=kali-nethunter-kernel-builder-main
NH_FILES="initrd.img ramdisk.img config-pro ikconfig_pro_readable.txt"

# --- obfuscation toolchains --------------------------------------------------
GOAT_REPO=https://github.com/015stray91/gimple-GCC-obfuscation-.git
GOAT_PIN=HEAD
GOAT_GCC=gcc-12
# goat passes safe on kernel code (FLA and BCF crash on computed gotos)
GOAT_PASSES="sub"
GOAT_SEED=deadbeef

TIGRESS_REPO=https://github.com/015stray91/Hikari-LLVM19.git
TIGRESS_PIN=HEAD
TIGRESS_VERSION=4.1.0
# Set to 1 once a complete Tigress 4.1.0 tree is vendored; the copy in the
# kernel tree is wrapper scripts only (no App::Cilly / CIL engine).
TIGRESS_ENABLED=0

# --- patches (relative to 6.12_nh-dark-matter-x86_64/) -----------------------
PATCH_KERNEL_SIDE="KernelSU-Next/50_add_susfs_in_gki-android16-6.12.patch \
KernelSU-Next/51_enhanced_susfs-android16-6.12.patch \
KernelSU-Next/60_zeromount-android16-6.12.patch \
KernelSU-Next/55_susfs_task_mmu_6.12_fix.patch"

# Single consolidated KernelSU-side patch (replaces the old 70 + 70b pair).
# Regenerated from the tree state that compiled with SUSFS+ZeroMount enabled:
# fixes the misplaced #else, adds the missing sh_user_path()/is_ksud_exists(),
# guards the syscall-table declarations, and trims Kbuild for SUSFS.
PATCH_KSU_SIDE="KernelSU-Next/70_ksu_next_susfs_x86_64_consolidated.patch"

# --- config ------------------------------------------------------------------
CONFIG_FRAGMENT=6.12_nh-dark-matter-x86_64/config-darkmatter-nhpro-x86_64.fragment
CONFIG_BASE=x86_64_defconfig
ARCH=x86_64

# --- target board ------------------------------------------------------------
BOARD_NAME="ASUS Vivobook Go 14/15"
BOARD_MODEL=E1404FA
BOARD_APU="AMD Mendocino (RDNA2)"
BOARD_BIOS=E1404FAAS.317

# --- required kernel options (workflow asserts these) -----------------------
REQUIRED_CONFIG="CONFIG_KSU CONFIG_KSU_SUSFS CONFIG_KSU_SUSFS_SUS_MOUNT CONFIG_ZEROMOUNT CONFIG_X86_64 CONFIG_KPROBES CONFIG_MODULES"

# must stay OFF: this tree already carries the indirect-syscall hardening
FORBIDDEN_CONFIG="CONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER"
