	 "alignof_float64"           : 0,
	 "alignof_double"             : 8,
	 "alignof_longdouble"         : 8,
	 "alignof_float16"            : 2,
	 "alignof_floatcomplex"       : 4,
	 "alignof_doublecomplex"      : 8,
	 "alignof_longdoublecomplex"  : 8,
	 "alignof_float128complex"    : 0,
	 "alignof_str"                : 1,
